<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Downloads the TTS model and voice catalog on first run (FR-20).
         WITHOUT THIS THE RELEASE BUILD CANNOT DOWNLOAD THE MODEL: Flutter
         adds INTERNET to debug builds automatically but NOT to release
         builds, so every model install would fail with the network error
         only in the store build. HTTPS only; documents never leave the
         device, so no cleartext exception is needed. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Keeps speech generation alive after the user leaves the app.
         FOREGROUND_SERVICE is required from API 28; the DATA_SYNC subtype is
         required from API 34, where Android rejects a foreground service that
         does not declare what kind of work it is. Generating audio files is
         data sync, not media playback — nothing is being played to the user. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <!-- The progress notification is the only way the user can see or stop a
         background run. Without it on API 33+ the service runs invisibly. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>

    <application
        android:label="VietDoc AI"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- Open a supported file with this app (FR-02, second half of the
                 Storage Access Framework picker flow). The extension-less data
                 elements are matched by MIME only, so Android does the heavy
                 lifting; the Dart side still verifies the magic numbers
                 (SRS §38) before trusting anything. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="application/pdf"/>
                <data android:mimeType="text/plain"/>
                <data android:mimeType="text/markdown"/>
                <data android:mimeType="application/epub+zip"/>
                <data android:mimeType="image/jpeg"/>
                <data android:mimeType="image/png"/>
                <data android:mimeType="image/webp"/>
            </intent-filter>

            <!-- Share to this app from other apps (FR-02). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/plain"/>
                <data android:mimeType="application/pdf"/>
                <data android:mimeType="image/jpeg"/>
                <data android:mimeType="image/png"/>
                <data android:mimeType="image/webp"/>
            </intent-filter>

            <!-- Share multiple files to this app. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="application/pdf"/>
                <data android:mimeType="image/*"/>
                <data android:mimeType="text/plain"/>
            </intent-filter>
        </activity>
        <!-- Runs the synthesis worker while the app is backgrounded, so closing
             the app does not abandon a document half-generated. See
             SynthesisService.kt for why this is hand-written rather than a package
             and what it does not survive. -->
        <service
            android:name=".SynthesisService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
